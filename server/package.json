{
  "name": "@nova/server",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node scripts/prisma.mjs migrate deploy && tsx watch --clear-screen=false src/index.ts",
    "build": "node scripts/prisma.mjs generate && node build.mjs",
    "start": "node scripts/prisma.mjs migrate deploy && node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:migrate": "node scripts/prisma.mjs migrate dev",
    "db:deploy": "node scripts/prisma.mjs migrate deploy",
    "db:studio": "node scripts/prisma.mjs studio",
    "migrate:concord": "tsx scripts/migrate-from-concord.ts",
    "postinstall": "node scripts/prisma.mjs generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@nova/shared": "*",
    "@prisma/client": "~6.19.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.0",
    "fastify": "^5.6.0",
    "heic-convert": "^2.1.0",
    "jose": "^6.1.0",
    "livekit-server-sdk": "^2.13.0",
    "nodemailer": "^7.0.6",
    "sharp": "^0.34.3",
    "socket.io": "^4.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.1",
    "esbuild": "^0.25.9",
    "pino-pretty": "^13.1.1",
    "prisma": "~6.19.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
