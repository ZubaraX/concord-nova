// Concord Nova data model — SQLite (one file, WAL mode). All ids are ULIDs
// generated by the app (time-sortable: they double as pagination cursors and
// "unread since" markers). Enum-like fields are strings (SQLite has no enums).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id
  username            String    @unique // lowercase handle, globally unique
  email               String    @unique
  passwordHash        String
  displayName         String?
  avatar              String?
  banner              String?
  accentColor         Int?
  bio                 String?
  pronouns            String?
  /// What the user picked: online | idle | dnd | invisible (kept across sessions)
  status              String    @default("online")
  customStatusText    String?
  customStatusEmoji   String?
  customStatusExpires DateTime?
  /// Device-independent app preferences (JSON), synced across desktop/Android/web.
  settings            String    @default("{}")
  flags               Int       @default(0)
  resetCode           String?
  resetExpires        DateTime?
  resetAttempts       Int       @default(0)
  /// Set by an instance admin: the account can't sign in until re-enabled.
  disabledAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions             Session[]
  memberships          Member[]
  ownedGuilds          Guild[]               @relation("GuildOwner")
  messages             Message[]
  recipientOf          ChannelRecipient[]
  relationships        Relationship[]        @relation("RelOwner")
  relatedTo            Relationship[]        @relation("RelTarget")
  reactions            Reaction[]
  readStates           ReadState[]
  notificationSettings NotificationSetting[]
  bookmarks            Bookmark[]
  pollVotes            PollVote[]
  uploads              Attachment[]
}

/// One signed-in device. The refresh token is stored only as a SHA-256 hash.
model Session {
  id          String   @id
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String   @unique
  device      String?
  platform    String?
  ip          String?
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())
  expiresAt   DateTime

  @@index([userId])
}

model Guild {
  id              String   @id
  name            String
  icon            String?
  banner          String?
  description     String?
  ownerId         String
  owner           User     @relation("GuildOwner", fields: [ownerId], references: [id])
  systemChannelId String?
  createdAt       DateTime @default(now())

  roles    Role[]
  members  Member[]
  channels Channel[]
  emojis   Emoji[]
  invites  Invite[]
  bans     Ban[]
  auditLog AuditLog[]

  @@index([ownerId])
}

/// The @everyone role has id == guild id.
model Role {
  id          String       @id
  guildId     String
  guild       Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name        String
  color       Int          @default(0)
  permissions String       @default("0")
  position    Int          @default(0)
  hoist       Boolean      @default(false)
  mentionable Boolean      @default(false)
  createdAt   DateTime     @default(now())
  members     MemberRole[]

  @@index([guildId])
}

model Member {
  guildId      String
  userId       String
  guild        Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  nick         String?
  joinedAt     DateTime     @default(now())
  timeoutUntil DateTime?
  roles        MemberRole[]

  @@id([guildId, userId])
  @@index([userId])
}

model MemberRole {
  guildId String
  userId  String
  roleId  String
  member  Member @relation(fields: [guildId, userId], references: [guildId, userId], onDelete: Cascade)
  role    Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([guildId, userId, roleId])
  @@index([roleId])
}

/// type: text | voice | category | announcement | dm | group_dm | thread
model Channel {
  id               String    @id
  type             String
  guildId          String?
  guild            Guild?    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  /// category for guild channels, the parent text channel for threads
  parentId         String?
  name             String    @default("")
  topic            String?
  position         Int       @default(0)
  nsfw             Boolean   @default(false)
  slowmode         Int       @default(0)
  bitrate          Int       @default(96000)
  userLimit        Int       @default(0)
  lastMessageId    String?
  lastPinAt        DateTime?
  /// group DM owner / thread creator
  ownerId          String?
  icon             String?
  archived         Boolean   @default(false)
  locked           Boolean   @default(false)
  messageCount     Int       @default(0)
  starterMessageId String?
  createdAt        DateTime  @default(now())

  overwrites PermissionOverwrite[]
  recipients ChannelRecipient[]
  messages   Message[]

  @@index([guildId])
  @@index([parentId])
}

model PermissionOverwrite {
  channelId String
  targetId  String
  /// role | member
  type      String
  allow     String  @default("0")
  deny      String  @default("0")
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([channelId, targetId])
}

model ChannelRecipient {
  channelId String
  userId    String
  /// Hidden from this user's DM list until a new message arrives.
  closed    Boolean @default(false)
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
}

model Message {
  id              String    @id
  channelId       String
  channel         Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId        String
  author          User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type            Int       @default(0)
  content         String    @default("")
  /// Lowercased, ё→е normalized copy of content for case-insensitive search.
  searchText      String    @default("")
  nonce           String?
  /// No FK on purpose: replies survive the original's deletion.
  replyToId       String?
  pinned          Boolean   @default(false)
  flags           Int       @default(0)
  mentions        String    @default("[]")
  mentionRoles    String    @default("[]")
  mentionEveryone Boolean   @default(false)
  embeds          String    @default("[]")
  meta            String?
  /// JSON: { question, allowMultiselect, expiresAt, finalized, answers: [{id,text,emoji}] }
  poll            String?
  threadId        String?
  editedAt        DateTime?
  createdAt       DateTime  @default(now())

  attachments Attachment[]
  reactions   Reaction[]
  pollVotes   PollVote[]
  bookmarks   Bookmark[]

  @@unique([authorId, nonce])
  @@index([channelId, id])
  @@index([channelId, pinned])
  @@index([authorId])
}

/// Uploaded first (messageId = null), then claimed by the message that uses it.
model Attachment {
  id          String   @id
  messageId   String?
  message     Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploaderId  String
  uploader    User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  filename    String
  /// Relative to the storage dir; served at /files/<path>.
  path        String
  size        BigInt
  contentType String?
  width       Int?
  height      Int?
  duration    Float?
  waveform    String?
  flags       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([messageId])
  @@index([uploaderId, messageId])
}

model Reaction {
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@index([messageId])
}

model PollVote {
  messageId String
  answerId  String
  userId    String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, answerId, userId])
  @@index([messageId])
}

model ReadState {
  userId       String
  channelId    String
  lastReadId   String?
  mentionCount Int     @default(0)
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
  @@index([channelId])
}

/// Two rows per relationship (one per side). type: 1 friend, 2 blocked, 3 incoming, 4 outgoing
model Relationship {
  userId   String
  targetId String
  type     Int
  since    DateTime @default(now())
  user     User     @relation("RelOwner", fields: [userId], references: [id], onDelete: Cascade)
  target   User     @relation("RelTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([userId, targetId])
  @@index([targetId])
}

model Invite {
  code      String    @id
  guildId   String
  guild     Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId String?
  inviterId String?
  uses      Int       @default(0)
  maxUses   Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([guildId])
}

model Ban {
  guildId   String
  userId    String
  reason    String?
  createdAt DateTime @default(now())
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, userId])
}

model Emoji {
  id        String   @id
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name      String
  path      String
  animated  Boolean  @default(false)
  creatorId String?
  createdAt DateTime @default(now())

  @@unique([guildId, name])
}

model AuditLog {
  id        String   @id
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  actorId   String
  action    String
  targetId  String?
  changes   String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([guildId, id])
}

/// targetId = a guild id or a channel id. level: default | all | mentions | none
model NotificationSetting {
  userId           String
  targetId         String
  level            String    @default("default")
  muted            Boolean   @default(false)
  muteUntil        DateTime?
  suppressEveryone Boolean   @default(false)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, targetId])
}

model Bookmark {
  userId    String
  messageId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
}

model ScheduledMessage {
  id          String   @id
  channelId   String
  authorId    String
  content     String
  /// JSON array of attachment ids (unclaimed uploads owned by the author)
  attachments String   @default("[]")
  sendAt      DateTime
  createdAt   DateTime @default(now())

  @@index([sendAt])
  @@index([authorId])
}

/// Instance-wide settings an instance admin can change at runtime
/// (registration mode, server name). Environment values are the defaults.
model InstanceSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
