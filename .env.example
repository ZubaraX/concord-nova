# Concord Nova — local development settings (copy to .env in the repo root).
# Production servers get /etc/nova/nova.env from deploy/setup.sh instead.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# Public address, used in invite links (https://chat.example.com)
PUBLIC_URL=
SERVER_NAME=Concord Nova
# Behind nginx / a reverse proxy: trust X-Forwarded-* headers
TRUST_PROXY=false

# Where the database, uploads and the generated JWT secret live (default: ./data)
DATA_DIR=
# STORAGE_DIR=            # uploads (default: $DATA_DIR/uploads)
# WEB_DIST=               # built web client to serve (default: client/dist)

# open | invite (valid server invite required) | closed
REGISTRATION=open
MAX_MESSAGE_LENGTH=20000
# 0 = unlimited (bounded by disk)
MAX_UPLOAD_BYTES=0

# LiveKit (voice / video / screen share). `npm run dev` starts a local
# LiveKit in --dev mode, which uses devkey/secret — leave these empty locally.
LIVEKIT_URL=
LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# GIF search (optional): https://klipy.com or Google Tenor
KLIPY_KEY=
TENOR_KEY=

# Password-reset e-mails (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

LOG_LEVEL=info
