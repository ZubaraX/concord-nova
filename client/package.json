{
  "name": "@nova/client",
  "version": "1.7.2",
  "private": true,
  "description": "Concord Nova",
  "author": "Concord Nova",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "preview": "vite preview",
    "build:electron": "node electron/build.mjs",
    "desktop:dev": "concurrently -k -n vite,electron -c magenta,cyan \"vite\" \"wait-on tcp:5173 && node electron/build.mjs && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "desktop:pack": "vite build && node electron/build.mjs && electron-builder --dir",
    "desktop:build": "vite build && node electron/build.mjs && electron-builder --win --publish never",
    "android:prepare": "node scripts/android-prepare.mjs",
    "android:build": "node scripts/android-build.mjs",
    "android:release": "node scripts/android-build.mjs --release"
  },
  "comment": "Everything is bundled at build time (Vite for the renderer, esbuild for Electron main/preload), so the packaged desktop app has no runtime node_modules.",
  "devDependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/cli": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@nova/shared": "*",
    "@sapphi-red/web-noise-suppressor": "^0.3.5",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "deepfilternet3-noise-filter": "1.3.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.6.2",
    "emojibase-data": "^16.0.3",
    "esbuild": "^0.25.9",
    "highlight.js": "^11.11.1",
    "livekit-client": "^2.15.0",
    "lucide-react": "^1.48.0",
    "motion": "^12.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-virtuoso": "^4.14.0",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4",
    "zustand": "^5.0.8"
  },
  "dependencies": {}
}
