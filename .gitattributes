# Shell scripts run on Linux servers: always LF, whatever the checkout OS.
*.sh text eol=lf
client/android-extras/** text eol=lf
*.png binary
*.ico binary
*.db binary
*.cmd text eol=crlf
*.wasm binary
*.bin binary
# The USB installer: files that land on a Linux server, LF too.
deploy/usb/nova/** text eol=lf
deploy/usb/*.yaml text eol=lf
deploy/usb/*.cfg text eol=lf
*.ps1 text eol=crlf
